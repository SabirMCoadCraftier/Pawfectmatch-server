# ─── LOCAL DEVELOPMENT ─────────────────────────────────
# Copy this file to .env and fill in your values.

PORT=5000

# MongoDB (Atlas) credentials
DB_USER=your_mongodb_username
DB_PASS=your_mongodb_password
DB_NAME=petAdoptionDB

# JWT secret (min 32 characters, use a strong random string)
ACCESS_TOKEN_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# Frontend URL (for CORS)
#   Local:  http://localhost:5173
#   Vercel: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# ─── VERCEL DEPLOYMENT ─────────────────────────────────
# On Vercel, set these as Environment Variables in the Dashboard:
#   DB_USER, DB_PASS, DB_NAME, ACCESS_TOKEN_SECRET, CLIENT_URL
# NODE_ENV and VERCEL are set automatically by Vercel.
